{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MasLight",
  "version": "0.1.0",
  "identifier": "dev.maslight.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MasLight",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "Open source ambilight for every screen",
    "longDescription": "MasLight drives addressable LED strips from what is on your screen. It speaks WLED UDP, DDP, sACN, Art-Net and Adalight, runs on Windows, Linux and macOS, and keeps everything on your own machine.",
    "copyright": "MasLight contributors, MIT licensed",
    "publisher": "MasLight",
    "homepage": "https://github.com/asermas/maslight",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
